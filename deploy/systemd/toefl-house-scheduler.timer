[Unit]
Description=Run The TOEFL House scheduler every minute
Documentation=https://github.com/Frotan2/TOEFL-House/blob/main/docs/operations/production-deployment.md

[Timer]
# Persistent=true coalesces downtime into one recovery run. The durable relay
# and retry sweep drain eligible backlog idempotently, so missed wall-clock
# occurrences do not need to be replayed individually.
OnCalendar=*-*-* *:*:00
Persistent=true
AccuracySec=1s
RandomizedDelaySec=0
Unit=toefl-house-scheduler.service

[Install]
WantedBy=timers.target
