<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- Canonical suite: derived from the current implementation and
             mutation-checked. See docs/TEST_SUITE_ARCHITECTURE.md. -->
        <testsuite name="Canonical">
            <directory>tests/Canonical</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            Isolation-critical settings are forced. Without force="true" a
            variable already present in the developer's shell wins over the
            value below, and that is not a theoretical hazard: `RefreshDatabase`
            runs `migrate:fresh`, which drops every table. Exporting
            DB_DATABASE=toefl_house_prod in a shell (the natural thing to do
            after copying the deployment .env) turns `php artisan test` into a
            production database deletion. Anything that selects *which* store is
            wiped or written to is therefore pinned here; connection host,
            port, user and password stay overridable so a test database can live
            on another cluster.
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:N9SUbypTX9WrF+XOAfYSOnmJhIsc9xXmZvTXlAkjStM="/>
        <env name="APP_NAME" value="The TOEFL House"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="APP_URL" value="http://localhost"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="toefl_house_test" force="true"/>
        <env name="DB_USERNAME" value="postgres"/>
        <env name="DB_PASSWORD" value="postgres"/>
    </php>
</phpunit>
